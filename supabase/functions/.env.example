# Copia in supabase/functions/.env (sviluppo) e usa `supabase secrets set --env-file` in produzione.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sono iniettate automaticamente da Supabase.

# --- Provider AI ---
# anthropic (default, produzione) | gemini (solo sviluppo/test, es. piano gratuito)
AI_PROVIDER=anthropic

# --- Google Gemini (solo se AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# MINIMAL | LOW | MEDIUM | HIGH — LOW = latenza bassa
GEMINI_THINKING_LEVEL=LOW
# Prezzi in USD per milione di token per il contatore costi (0 = piano gratuito)
GEMINI_PRICE_INPUT_PER_MTOK=0
GEMINI_PRICE_OUTPUT_PER_MTOK=0

# --- Anthropic (solo server, MAI nell'app) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high — `low` = latenza minima
ANTHROPIC_EFFORT=low
# adaptive | between_tools (thinking disattivato: usalo se la p95 supera i 7 s)
ANTHROPIC_THINKING=adaptive
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT_MS=15000
# Fallback server-side in caso di rifiuto dei classificatori (true/false)
ANTHROPIC_SERVER_FALLBACK=true

# --- RevenueCat ---
# Project settings → API keys → Secret API key (v1)
REVENUECAT_SECRET_API_KEY=sk_...
# Stesso valore impostato come "Authorization header" nel webhook RevenueCat
REVENUECAT_WEBHOOK_AUTH=una-stringa-lunga-e-casuale
