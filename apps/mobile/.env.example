# Variabili pubbliche (finiscono nel bundle: MAI chiavi segrete qui).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# RevenueCat → Project → API keys → Public app-specific keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# Mostra "Continua con Google" solo dopo aver configurato il provider su Supabase
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Beta chiusa: il paywall diventa "accesso su invito" (accesso concesso con grant_beta_access)
EXPO_PUBLIC_CLOSED_BETA=false
# Beta aperta: si entra senza email come ospite (richiede gli accessi anonimi attivi su Supabase)
EXPO_PUBLIC_OPEN_BETA=false
# Solo per hosting in sottocartella, es. GitHub Pages: /Caption
EXPO_PUBLIC_BASE_URL=
